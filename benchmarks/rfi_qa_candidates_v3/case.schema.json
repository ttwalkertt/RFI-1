{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/rfi-qa-independent-v3-case.schema.json",
  "title": "Independent RFI QA benchmark case v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_version",
    "case_id",
    "pair_id",
    "title",
    "fixture_id",
    "difficulty",
    "adjudicability",
    "investigation_question",
    "answer_requirements",
    "submitted_answer",
    "reference_qa"
  ],
  "properties": {
    "benchmark_version": {"const": "rfi-qa-independent-v3.0.0"},
    "case_id": {"type": "string", "pattern": "^R3(?:C|Q)-[0-9]{3}$"},
    "pair_id": {
      "anyOf": [
        {"type": "string", "pattern": "^R3P-[0-9]{3}$"},
        {"type": "null"}
      ]
    },
    "title": {"type": "string", "minLength": 1},
    "fixture_id": {"type": "string", "pattern": "^R3F-(?:[0-9]{3}|Q[0-9]{3})$"},
    "difficulty": {"enum": ["atomic", "multi_record", "authority_boundary", "judgment_dependent"]},
    "adjudicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "human_review_required", "note"],
      "properties": {
        "status": {"enum": ["objective", "borderline"]},
        "human_review_required": {"type": "boolean"},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "investigation_question": {"type": "string", "minLength": 1},
    "answer_requirements": {"type": "string", "minLength": 1},
    "submitted_answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "evidence_locators"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "evidence_locators": {
          "type": "array",
          "items": {"type": "string", "pattern": "^rfiqa-v3://"},
          "uniqueItems": true
        }
      }
    },
    "reference_qa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "material_findings", "defect_classes", "rationale", "adjudication_evidence"],
      "properties": {
        "disposition": {"enum": ["supported", "defective", "indeterminate"]},
        "material_findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "defect_classes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "rationale": {"type": "string", "minLength": 1},
        "adjudication_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/adjudication_item"}
        }
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "severity", "defect_class", "affected_claim", "finding", "evidence_locators"],
      "properties": {
        "finding_id": {"type": "string", "pattern": "^R3(?:C|Q)-[0-9]{3}-F[1-9][0-9]*$"},
        "severity": {"const": "material"},
        "defect_class": {"type": "string", "minLength": 1},
        "affected_claim": {"type": "string", "minLength": 1},
        "finding": {"type": "string", "minLength": 1},
        "evidence_locators": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^rfiqa-v3://"},
          "uniqueItems": true
        }
      }
    },
    "adjudication_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "role", "fact"],
      "properties": {
        "locator": {"type": "string", "pattern": "^rfiqa-v3://"},
        "role": {"type": "string", "minLength": 1},
        "fact": {"type": "string", "minLength": 1}
      }
    }
  }
}
