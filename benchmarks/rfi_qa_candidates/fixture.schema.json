{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/rfi-qa-fixtures.schema.json",
  "title": "RFI QA synthetic fixture collection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixtures"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fixture_id", "title", "authority", "records"],
        "properties": {
          "fixture_id": {"type": "string", "pattern": "^FX-(?:[0-9]{3}|B[0-9]{2})$"},
          "title": {"type": "string", "minLength": 1},
          "authority": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "scope", "absence_claims"],
            "properties": {
              "mode": {"enum": ["complete", "partial", "dimension_complete"]},
              "scope": {"type": "string", "minLength": 1},
              "absence_claims": {"type": "string", "minLength": 1}
            }
          },
          "records": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["evidence_id", "locator", "content"],
              "properties": {
                "evidence_id": {"type": "string", "pattern": "^E[1-9][0-9]*$"},
                "locator": {"type": "string", "pattern": "^fixture://"},
                "content": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
